# Compose defaults. Copy to .env only if you need to override.
POSTGRES_DB=printsheet
POSTGRES_USER=printsheet
POSTGRES_PASSWORD=printsheet_dev_only
WORKER_KEY=dev-worker-key
API_PORT=8080
WORKER_PORT=8000
WEB_PORT=5173

# Background removal. The default self-hosted provider needs no key.
# Switch to Poof only with a real key; leaving it empty makes the adapter
# report an availability failure instead of making a billed call.
WITHOUTBG_PORT=8002
BACKGROUND_REMOVAL_PROVIDER=withoutbg
BACKGROUND_REMOVAL_FALLBACK=
# Set to false to stop the API executing queued cutouts itself (read-only or
# migration instances); jobs then stay queued until an instance with the runner
# enabled picks them up.
BACKGROUND_REMOVAL_RUN_JOBS=true
POOF_API_KEY=
# Pixel budgets per provider. The CPU model mattes at its own low internal
# resolution and takes ~30 s per MP, so it is capped; Poof returns a
# full-resolution matte in seconds, so it is only bounded against huge uploads.
BACKGROUND_REMOVAL_WITHOUTBG_MAX_INPUT_PIXELS=1000000
BACKGROUND_REMOVAL_POOF_MAX_INPUT_PIXELS=24000000
WORKER_GPU_ENABLED=false
