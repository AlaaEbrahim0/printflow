{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PrintSheet": "Host=CHANGE_ME;Port=5432;Database=printsheet;Username=printsheet;Password=CHANGE_ME"
  },
  "Database": {
    "Provider": "Postgres"
  },
  "Storage": {
    "Root": "/data/storage"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Worker": {
    "Key": "CHANGE_ME"
  },
  "BackgroundRemoval": {
    "DefaultProvider": "withoutbg",
    "FallbackProvider": "",
    "RemoveEnclosedBackgroundByDefault": false,
    "MinCounterAreaPx": 64,
    "MaxCounterAreaFraction": 0.10,
    "Solid": {
      "BackgroundTolerance": 22,
      "MinBorderUniformity": 0.90,
      "MaxBorderForegroundRatio": 0.02,
      "EdgeBandPixels": 3,
      "MinSpeckArea": 12
    }
  },
  "Intake": {
    "MaxUploadBytes": 52428800,
    "MaxDimensionPx": 30000
  },
  "Preflight": {
    "Enabled": true,
    "Profile": {
      "Name": "dtf",
      "MinimumDpi": 200,
      "RecommendedDpi": 300,
      "MaximumSoftEdgeDepthMm": 0.5,
      "MaximumSoftInteriorFraction": 0.005,
      "SoftEdgeBandMm": 0.3,
      "MinimumStrokeMm": 0.5,
      "CriticalStrokeMm": 0.25,
      "MinimumGapMm": 0.5,
      "MinimumIslandAreaMm2": 1.0,
      "MinimumHoleAreaMm2": 0.5,
      "MinimumContrastRatio": 1.5,
      "ContrastOpacities": [0.25, 0.6],
      "MaximumCoverageFraction": 0.6,
      "MaximumRegions": 10,
      "MinimumMarginMm": 1.0
    }
  }
}
