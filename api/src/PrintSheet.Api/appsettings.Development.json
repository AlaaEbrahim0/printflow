{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "PrintSheet": "Data Source=printsheet.dev.db"
  },
  "Storage": {
    "Root": "storage"
  },
  "BackgroundRemoval": {
    "DefaultProvider": "withoutbg",
    "PrepareWorker": {
      "BaseUrl": "http://localhost:8000",
      "WorkerKey": "dev-worker-key",
      "UseGpu": true
    },
    "WithoutBg": {
      "BaseUrl": "http://localhost:8002"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
