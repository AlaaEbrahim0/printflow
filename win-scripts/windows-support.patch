+    settings = make_settings(
+        tmp_path,
+        realesrgan_binary=make_executable(tmp_path / "bin" / "realesrgan-ncnn-vulkan"),
+        realesrgan_gpu_threads="2:2:2",
+        gpu_enabled=True,
+    )
+    storage = StorageRoot(settings.storage_root)
+    storage.resolved_root.mkdir(parents=True, exist_ok=True)
+
+    gpu_runner = FakeCommandRunner(writer=write_scaled_png(2))
+    run_upscale(
+        storage, settings, gray_screenshot(size=(40, 30)),
+        {"model": "realesrgan-x4plus", "scale": 2, "gpu": True}, gpu_runner,
+    )
+    assert gpu_runner.flag("-j") == "2:2:2"
+
+    cpu_runner = FakeCommandRunner(writer=write_scaled_png(2))
+    run_upscale(
+        storage, settings, gray_screenshot(size=(40, 30)),
+        {"model": "realesrgan-x4plus", "scale": 2, "gpu": False}, cpu_runner,
+    )
+    assert "-j" not in cpu_runner.last_command()
+
+
