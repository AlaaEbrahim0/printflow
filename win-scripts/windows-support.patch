@@ -182,7 +182,9 @@ class StorageRoot:
 
     @staticmethod
     def _sync_file(path: Path) -> None:
-        with open(path, "rb") as handle:
+        # "r+b", not "rb": Windows' fsync (FlushFileBuffers) needs a write-capable
+        # handle and raises EBADF on a read-only one, which would fail every write.
+        with open(path, "r+b") as handle:
             handle.flush()
             os.fsync(handle.fileno())
 
